# ──────────────────────────────────────────────────────────────────────────────
# LectureMind — Environment Variables Template
# ──────────────────────────────────────────────────────────────────────────────
# INSTRUCTIONS:
#   1. Copy this file to ".env.local" in the project root.
#   2. Fill in your real API keys below (NEVER commit .env.local).
#   3. For mobile: keys are seeded into FlutterSecureStorage on first launch.
#   4. For Flutter Web: inject at build time via --dart-define flags (see below).
# ──────────────────────────────────────────────────────────────────────────────

# AssemblyAI Real-time STT + async transcription
ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here

# Groq Ultra-fast LLM inference (primary AI engine)
GROQ_API_KEY=your_groq_api_key_here

# Google Gemini Multimodal fallback + document analysis
GEMINI_API_KEY=your_gemini_api_key_here

# ─── Flutter Build Commands ───────────────────────────────────────────────────
# Mobile Debug:
#   flutter run --dart-define=ASSEMBLYAI_API_KEY=%ASSEMBLYAI_API_KEY% --dart-define=GROQ_API_KEY=%GROQ_API_KEY% --dart-define=GEMINI_API_KEY=%GEMINI_API_KEY%
# Mobile Release:
#   flutter build apk --release --split-per-abi --dart-define=ASSEMBLYAI_API_KEY=%ASSEMBLYAI_API_KEY% --dart-define=GROQ_API_KEY=%GROQ_API_KEY% --dart-define=GEMINI_API_KEY=%GEMINI_API_KEY%
# Flutter Web:
#   flutter build web --release --dart-define=ASSEMBLYAI_API_KEY=%ASSEMBLYAI_API_KEY% --dart-define=GROQ_API_KEY=%GROQ_API_KEY% --dart-define=GEMINI_API_KEY=%GEMINI_API_KEY%
